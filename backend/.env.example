# Sous Chef Backend - Environment Configuration
# Copy to .env and fill in your values (see README for export commands).

# Required for Vertex AI / Gemini Live API
# Your Google Cloud project ID (You can find it in: https://console.cloud.google.com/home/dashboard)
GOOGLE_CLOUD_PROJECT=

# Vertex AI region (e.g. us-central1)
GOOGLE_CLOUD_LOCATION=

# Use Vertex AI for Gemini
GOOGLE_GENAI_USE_VERTEXAI=True

# Gemini Live Model
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# Google Maps / Places API key (required for place search and photos)
GOOGLE_MAPS_API_KEY=

# Set to true to enable Google Search
GEMINI_GOOGLE_SEARCH=True

GEMINI_AFFECTIVE_DIALOG=True
